namespace solarxr_protocol.rpc;

/// Request to get currently registered plugin bones from loaded plugins.
table GetPluginBonesRequest {}

/// Response containing the list of plugin bones.
/// Each PluginBone represents a virtual bone exposed by a plugin for tracker assignment or other purposes.
table GetPluginBonesResponse {
    /// List of PluginBone objects registered by loaded plugins.
    /// Empty if no plugins have registered bones.
    bones: [PluginBone];
}

table PluginBone {
    id: string;
    name: string;
    parent_bone_id: string;
    local_position_x: float32 = 0.0;
    local_position_y: float32 = 0.0;
    local_position_z: float32 = 0.0;
    local_rotation_x: float32 = 0.0;
    local_rotation_y: float32 = 0.0;
    local_rotation_z: float32 = 0.0;
    local_rotation_w: float32 = 1.0;
    vmc_bone_name: string;
    vrc_osc_param_name: string;
    /// URL to a model file (e.g., glTF/GLB) that can be attached to this bone.
    model_url: string;
}

table PluginBonesUpdateResponse {
    bones: [PluginBone];
}
